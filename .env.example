# Django
SECRET_KEY=change-me-in-production
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0

# Database. Se omite para usar SQLite; docker-compose la define hacia Postgres.
# DATABASE_URL=postgres://bookstore:bookstore@db:5432/bookstore

# Frontend permitido por CORS
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Reglas de negocio
LOCAL_CURRENCY=EUR
PROFIT_MARGIN_PERCENTAGE=40

# Integración de tasas de cambio
EXCHANGE_RATE_API_URL=https://api.exchangerate-api.com/v4/latest
EXCHANGE_RATE_TIMEOUT_SECONDS=5
EXCHANGE_RATE_CACHE_SECONDS=600
